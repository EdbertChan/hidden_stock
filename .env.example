# Required
ANTHROPIC_API_KEY=sk-ant-...
# Gemini Flash for LIFO/FIFO + business-description extract (not Claude Code)
GEMINI_API_KEY=
# SEC requires a descriptive User-Agent with a contact email on every request
SEC_EDGAR_USER_AGENT="hidden-stock-screener you@example.com"

# EODHD price history API (primary source; yfinance is the fallback if unset
# or if a request fails) — https://eodhd.com, paid plan for delisted tickers
EODHD_API_KEY=

# Universe/index config knob — sp500 | russell2000 | russell3000
UNIVERSE_INDEX_SOURCE=sp500

# Only needed if running `dagster dev` locally (outside Docker Compose) against
# the same Postgres — inside Compose these are set directly in docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster
POSTGRES_DB=dagster

# Google Sheets export
# Path to service-account JSON (or raw JSON). SA cannot create files (0 Drive quota).
GOOGLE_SHEETS_CREDENTIALS_JSON=
# Prefer user OAuth to create a *new* experiment spreadsheet each run:
#   python scripts/google_sheets_oauth_setup.py --client-secrets /path/to/client_secret.json
GOOGLE_SHEETS_OAUTH_CLIENT_SECRETS=
GOOGLE_SHEETS_OAUTH_TOKEN=
GOOGLE_SHEETS_CREATE_NEW=1
# Optional: Shared Drive folder ID (SA can create there if Content Manager)
GOOGLE_SHEETS_DRIVE_FOLDER_ID=
# Only used with --reuse-sheet / CREATE_NEW=0
GOOGLE_SHEETS_SPREADSHEET_ID=
