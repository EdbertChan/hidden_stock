{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judge",
    "verdict",
    "score",
    "blocking_issues",
    "minor_issues",
    "what_looks_good",
    "checks",
    "summary",
    "recommended_fixes",
    "root_cause_class",
    "avoid_next_time"
  ],
  "properties": {
    "judge": { "type": "string" },
    "verdict": { "type": "string", "enum": ["pass", "fail", "needs_work"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "minor_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "what_looks_good": { "type": "array", "items": { "type": "string" } },
    "checks": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "units_hkd_mn": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "pdf_window": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "pdd_child_band": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "parent_vs_child": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "broker_provenance": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "no_otc_invent_marks": { "type": "string", "enum": ["pass", "fail", "unknown"] }
      }
    },
    "summary": { "type": "string" },
    "recommended_fixes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "1–3 concrete code/data actions (file/function when possible)"
    },
    "root_cause_class": {
      "type": ["string", "null"],
      "description": "e.g. unit_mixup, parent_child_column_confusion, wrong_pdf_window"
    },
    "avoid_next_time": {
      "type": ["string", "null"],
      "description": "Mechanical assert that would have blocked ship"
    }
  }
}
